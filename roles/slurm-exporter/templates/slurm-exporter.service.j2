[Unit]
Description=Conclave Backend
After=network.target

[Service]
User={{ service_user | default("root") }}
WorkingDirectory={{ source_dir | default("/opt/slurm-exporter") }}
ExecStart={{ binary_dest | default("/usr/local/bin/slurm-exporter") }}
Restart=on-failure

[Install]
WantedBy=multi-user.target